        {% if section.settings.autoplay and section.settings.autoplay_progress_bar %}
            <div class="carousel-autoplay-progress-bar {{ section.settings.autoplay_progress_bar_color | escape }}"></div>
        {% endif %}

    </div>

</div>

{% schema %}
{
  "name": "Carousel",
  "settings": [
    {
      "type": "checkbox",
      "id": "controls",
      "default": true,
      "label": "Show controls",
      "info": "Previous / Next Buttons"
    },
    {
      "type": "checkbox",
      "id": "indicators",
      "default": true,
      "label": "Show indicators",
      "info": "Small dots at the bottom"
    },
    {
      "type": "select",
      "id": "bg_color",
      "label": "Background color",
      "info": "May be visible on slide change.",
      "default": "bg-custom-gradient",
      "options": [
        {
          "group": "Light",
          "value": "bg-white",
          "label": "White"
        },
        {
          "group": "Light",
          "value": "bg-light",
          "label": "Light"
        },
        {
          "group": "Dark",
          "value": "bg-dark",
          "label": "Dark"
        },
        {
          "group": "Dark",
          "value": "bg-primary",
          "label": "Primary"
        },
        {
          "group": "Dark",
          "value": "bg-secondary",
          "label": "Secondary"
        },
        {
          "group": "Gradient",
          "value": "bg-dark-gradient",
          "label": "Dark"
        },
        {
          "group": "Gradient",
          "value": "bg-primary-gradient",
          "label": "Primary"
        },
        {
          "group": "Gradient",
          "value": "bg-secondary-gradient",
          "label": "Secondary"
        },
        {
          "group": "Gradient",
          "value": "bg-custom-gradient",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "backdrop",
      "label": "Gradient backdrop",
      "info": "Useful for making subtitle text more readable.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "container",
      "label": "Disable full width",
      "default": true
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "default": true,
      "label": "Enable Autoplay"
    },
    {
      "type": "range",
      "id": "interval",
      "min": 3,
      "max": 20,
      "step": 1,
      "unit": "sec",
      "label": "Autoplay time",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "autoplay_progress_bar",
      "label": "Show progress bar",
      "default": true
    },
    {
      "type": "select",
      "id": "autoplay_progress_bar_color",
      "label": "Progress bar color",
      "default": "bg-custom-gradient",
      "options": [
        {
          "value": "bg-white",
          "label": "White"
        },
        {
          "value": "bg-white opacity-50",
          "label": "White (50% opacity)"
        },
        {
          "value": "bg-primary",
          "label": "Primary"
        },
        {
          "value": "bg-secondary",
          "label": "Secondary"
        },
        {
          "value": "bg-success",
          "label": "Success"
        },
        {
          "value": "bg-danger",
          "label": "Danger"
        },
        {
          "value": "bg-warning",
          "label": "Warning"
        },
        {
          "value": "bg-info",
          "label": "Info"
        },
        {
          "value": "bg-custom-gradient",
          "label": "Custom Gradient"
        }
      ]
    },
    {
      "type": "header",
      "content": "Transition"
    },
    {
      "type": "select",
      "id": "transition_effect",
      "label": "Transition Effect",
      "default": "carousel-animate-css carousel-jack",
      "info": "Learn more about [Animate.css](https://animate.style)",
      "options": [
        {
          "group": "Default",
          "value": "",
          "label": "Slide"
        },
        {
          "group": "Default",
          "value": "carousel-fade",
          "label": "Fade"
        },
        {
          "group": "Animate.css",
          "value": "carousel-animate-css carousel-back",
          "label": "Back"
        },
        {
          "group": "Animate.css",
          "value": "carousel-animate-css carousel-fade-big",
          "label": "Fade Big"
        },
        {
          "group": "Animate.css",
          "value": "carousel-animate-css carousel-slide-left-right",
          "label": "Slide left/right"
        },
        {
          "group": "Animate.css",
          "value": "carousel-animate-css carousel-slide-up-down",
          "label": "Slide up/down"
        },
        {
          "group": "Animate.css",
          "value": "carousel-animate-css carousel-zoom",
          "label": "Zoom"
        },
        {
          "group": "Animate.css",
          "value": "carousel-animate-css carousel-rotate",
          "label": "Rotate"
        },
        {
          "group": "Animate.css",
          "value": "carousel-animate-css carousel-jack",
          "label": "Jack In The Box"
        },
        {
          "group": "Animate.css",
          "value": "carousel-animate-css carousel-roll",
          "label": "Roll"
        },
        {
          "group": "Animate.css",
          "value": "carousel-animate-css carousel-flip-y",
          "label": "FlipY"
        }
      ]
    },
    {
      "type": "select",
      "id": "transition_speed",
      "label": "Transition Speed",
      "default": "animate__normal",
      "options": [
        {
          "value": "animate__slower",
          "label": "Slower"
        },
        {
          "value": "animate__slow",
          "label": "Slow"
        },
        {
          "value": "animate__normal",
          "label": "Normal"
        },
        {
          "value": "animate__fast",
          "label": "Fast"
        },
        {
          "value": "animate__faster",
          "label": "Faster"
        }
      ]
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "info": "0 = no overlay, 100 = fully dark",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "checkbox",
      "id": "lazyload",
      "label": "Lazyload images",
      "info": "Increase page speed by preloading only the first image.",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing",
      "info": "Based on Bootstrap Spacing Utility Classes [Learn More](https://getbootstrap.com/docs/4.5/utilities/spacing/)"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 9
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "info": "Suggestion (1920x600).",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "imagemb",
          "info": "Suggestion (600x600).",
          "label": "Mobile Image"
        },
        {
          "type": "header",
          "content": "Text Overlay"
        },
        {
          "type": "text",
          "id": "caption_title",
          "label": "Heading",
          "default": "Comfort, Care and Joy for Every Paw"
        },
        {
          "type": "select",
          "id": "caption_title_heading",
          "label": "Heading size",
          "default": "h1",
          "options": [
            {"value": "h1", "label": "Extra Large"},
            {"value": "h2", "label": "Large"},
            {"value": "h3", "label": "Medium"},
            {"value": "h4", "label": "Small"}
          ]
        },
        {
          "type": "textarea",
          "id": "caption_description",
          "label": "Description",
          "default": "Thoughtfully selected pet essentials designed to make everyday life happier, easier, and more comfortable."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop Best Sellers"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL",
          "info": "Leave blank to disable"
        },
        {
          "type": "text",
          "id": "button_text_secondary",
          "label": "Secondary button text",
          "default": "Explore All Products"
        },
        {
          "type": "url",
          "id": "button_url_secondary",
          "label": "Secondary button URL",
          "info": "Leave blank to disable"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "category": "Banner",
      "blocks": []
    }
  ]
}
{% endschema %}
