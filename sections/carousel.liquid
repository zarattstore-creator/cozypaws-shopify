                                        {% if section.settings.overlay_opacity > 0 %}
                        <div class="carousel-overlay" style="background: rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }}); position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;"></div>
                    {% endif %}

                    {% if block.settings.caption_title != blank or block.settings.caption_description != blank or block.settings.button_url != blank %}
                        <div class="carousel-caption" style="bottom: 50%; transform: translateY(50%); text-align: center;">
                            {% unless block.settings.caption_title == blank %}
                                <h3 class="{{ block.settings.caption_title_heading }}">
                                    {{ block.settings.caption_title }}
                                </h3>
                            {% endunless %}
                            {% unless block.settings.caption_description == blank %}
                                <div class="rte lead opacity-90 text-white mb-4" style="max-width: 600px; margin: 0 auto;">
                                    {{ block.settings.caption_description }}
                                </div>
                            {% endunless %}
                            {% if block.settings.button_url != blank %}
                                <a href="{{ block.settings.button_url }}" class="btn btn-lg btn-primary mr-2 mb-2">
                                    {{ block.settings.button_text | default: 'Shop Now' }}
                                </a>
                            {% endif %}
                            {% if block.settings.button_url_secondary != blank %}
                                <a href="{{ block.settings.button_url_secondary }}" class="btn btn-lg btn-outline-light mb-2">
                                    {{ block.settings.button_text_secondary | default: 'Explore All Products' }}
                                </a>
                            {% endif %}
                        </div>
                    {% endif %}

                </div>
            {% endfor %}
        </div>

        {% if section.settings.controls %}
            <a
                class="carousel-control-prev"
                href="#{{ 'carousel-' | append: section.id }}"
                role="button"
                data-slide="prev"
                aria-controls="{{ 'carousel-inner' | append: section.id }}">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="sr-only">{{ 'general.accessibility.previous' | t }}</span>
            </a>
            <a
                class="carousel-control-next"
                href="#{{ 'carousel-' | append: section.id }}"
                role="button" data-slide="next"
                aria-controls="{{ 'carousel-inner' | append: section.id }}">
