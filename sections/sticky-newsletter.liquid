
{% assign show_sticky_newsletter = false %}

{% if section.settings.enable_section %}
    {% if section.settings.show_only_homepage == false or template.name == 'index' %}
        {% if template.name != 'product' %}
            {% assign show_sticky_newsletter = true %}
        {% endif %}
    {% endif %}
{% endif %}

{% if show_sticky_newsletter %}
    <div
        id="sticky-newsletter-wrapper"
        class="toast-wrapper {{ section.settings.position }}">
        <div
            id="sticky-newsletter"
            class="toast hide animate__animated"
            data-autohide="false"
            data-animate-enter="{{ section.settings.animation_enter }}"
            data-animate-exit="{{ section.settings.animation_exit }}"
            data-animate-speed="{{ section.settings.animation_speed }}"
            data-top-treshold="{{ section.settings.top_treshold }}"
            data-bottom-treshold="{{ section.settings.bottom_treshold }}"
            data-show-after-x-days="{{ section.settings.show_after_x_days }}">

            <div class="toast-header py-2">
                <div class="mr-auto">
                    <strong class="line-height-normal">
                        {{ section.settings.title | escape }}
                    </strong>
                </div>
                <button
                    type="button"
                    class="sticky-newsletter-handle-close ml-2 mb-1 close"
                    aria-label="{{ 'general.accessibility.close' | t }}">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="toast-body">
                {% unless section.settings.description == blank %}
                    <div
                        id="sticky-newsletter-description"
                        class="description rte text-muted">
                        {{ section.settings.description }}
                    </div>

                    <!-- Newsletter form -->
                    {% form 'customer', id: 'sticky_newsletter_form', class: '' %}
                        <input type="hidden" name="contact[tags]" value="newsletter">

                        <div class="input-group mb-1">
                            <input
                                type="email"
                                name="contact[email]"
                                size="30"
                                class="form-control"
                                value="{% if customer.email != blank %}{{ customer.email }}{% endif %}"
                                placeholder="{{ 'general.newsletter.label' | t }}"
                                aria-label="{{ 'general.newsletter.label' | t }}"
                                autocorrect="off"
                                autocapitalize="off">
                            <div class="input-group-append">
                                <button
                                    type="submit"
                                    name="commit"
                                    class="btn d-flex align-items-center flex-shrink-0 {{ section.settings.btn_color }} {{ section.settings.btn_size }}">
                                    {% render 'icon-email', size: 21 %}
                                    <span class="sr-only">
                                        {{ 'general.newsletter.submit' | t }}
                                    </span>
                                </button>
                            </div>
                        </div>

                        <button
                            type="button"
                            id="sticky-newsletter-close-text"
                            class="sticky-newsletter-handle-close btn btn-block btn-sm btn-link text-decoration-underline text-secondary">
                            {{ 'general.newsletter.sticky_close' | t }}
                        </button>

                    {% endform %}

                {% endunless %}
            </div>
        </div>
    </div>
{% endif %}

{% schema %}
{
  "name": "Sticky newsletter",
  "settings": [
    {
      "type": "paragraph",
      "content": "Display a newsletter subscription form, usually offering a coupon code when signing up."
    },
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable selection",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_only_homepage",
      "label": "Show only on homepage",
      "info": "We recommend that you only show the home page. On product pages, it will always be hidden",
      "default": true
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "default": "bottom-center",
      "options": [
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom center"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ]
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "GET 10% DISCOUNT NOW!"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Get immediately <strong>10% OFF</strong> on your first purchase when you sign up for our newsletters!</p>"
    },
    {
      "type": "text",
      "id": "top_treshold",
      "label": "Upper threshold (px)",
      "info": "It will be shown after scrolling as many pixels from the top.",
      "default": "1000"
    },
    {
      "type": "text",
      "id": "bottom_treshold",
      "label": "Lower threshold (px)",
      "info": "It will hide after reaching that amount of pixels from the bottom",
      "default": "500"
    },
    {
      "type": "range",
      "id": "show_after_x_days",
      "label": "Show again after x days",
      "info": "If the user closes the popup, it will appear again after that number of days. We recommend that you set 3 days or more.",
      "min": 1,
      "max": 30,
      "default": 3
    },
    {
      "type": "select",
      "id": "btn_color",
      "label": "Button color",
      "default": "btn-primary",
      "options": [
        {
          "group": "Normal",
          "value": "btn-light",
          "label": "Light"
        },
        {
          "group": "Normal",
          "value": "btn-dark",
          "label": "Dark"
        },
        {
          "group": "Normal",
          "value": "btn-primary",
          "label": "Primary from theme"
        },
        {
          "group": "Normal",
          "value": "btn-secondary",
          "label": "Secondary from theme"
        },
        {
          "group": "Normal",
          "value": "btn-success",
          "label": "Success"
        },
        {
          "group": "Normal",
          "value": "btn-danger",
          "label": "Danger"
        },
        {
          "group": "Normal",
          "value": "btn-warning",
          "label": "Warning"
        },
        {
          "group": "Normal",
          "value": "btn-info",
          "label": "Info"
        },
        {
          "group": "Outline",
          "value": "btn-outline-dark",
          "label": "Dark outline"
        },
        {
          "group": "Outline",
          "value": "btn-outline-primary",
          "label": "Primary from theme outline"
        },
        {
          "group": "Outline",
          "value": "btn-outline-secondary",
          "label": "Secondary from theme outline"
        },
        {
          "group": "Outline",
          "value": "btn-outline-success",
          "label": "Success outline"
        },
        {
          "group": "Outline",
          "value": "btn-outline-danger",
          "label": "Danger outline"
        },
        {
          "group": "Outline",
          "value": "btn-outline-warning",
          "label": "Warning outline"
        },
        {
          "group": "Outline",
          "value": "btn-outline-info",
          "label": "Info outline"
        }
      ]
    },
    {
      "type": "select",
      "id": "btn_size",
      "label": "Button size",
      "options": [
        {
          "value": "btn-sm",
          "label": "Small"
        },
        {
          "value": "",
          "label": "Normal"
        },
        {
          "value": "btn-lg",
          "label": "Large"
        }
      ]
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "text",
      "id": "animation_enter",
      "label": "Entry Animation",
      "info": "Copy and paste the name of the animation (entry) from the website animate.style. Leave blank to disable and use Bootstrap's default transitions. [Learn more](https://animate.style)",
      "default": "animate__fadeInUp"
    },
    {
      "type": "text",
      "id": "animation_exit",
      "label": "Exit Animation",
      "info": "Copy and paste the name of the animation (exit) from the website animate.style. Leave blank to disable and use Bootstrap's default transitions. [Learn more](https://animate.style)",
      "default": "animate__fadeOutDown"
    },
    {
      "type": "select",
      "id": "animation_speed",
      "label": "Animation Speed",
      "default": "animate__normal",
      "options": [
        {
          "value": "animate__slower",
          "label": "Slower"
        },
        {
          "value": "animate__slow",
          "label": "Slow"
        },
        {
          "value": "animate__normal",
          "label": "Normal"
        },
        {
          "value": "animate__fast",
          "label": "Fast"
        },
        {
          "value": "animate__faster",
          "label": "Faster"
        }
      ]
    }
  ]
}
{% endschema %}
