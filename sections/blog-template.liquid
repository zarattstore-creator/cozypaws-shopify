<section>

    <!-- Header -->
    <header
        id="page-header"
        class="page-header text-center mb-9">
        <div class="container">

            <h3 class="">
                {{ blog.title }}
            </h3>

            {% unless section.settings.description == blank %}
                <div class="rte lead text-muted">
                    {{ section.settings.description }}
                </div>
            {% endunless %}

            <!-- Tags -->
            {% if section.settings.show_tags and blog.all_tags.size > 0 %}
                <div id="header-tags" class="d-flex align-items-center justify-content-center" style="line-height: normal;">
                    <p class="mb-0 mr-2 sr-only">
                        {{ 'general.tags' | t }}
                    </p>
                    <ul class="list-unstyled d-flex flex-wrap justify-content-center m-0">
                        {% for tag in blog.all_tags %}
                            {% if current_tags contains tag %}
                                <li class="active list-inline-item mx-0">
                                    <span class="sr-only">{{ 'general.remove_tag' | t: tag: tag }}</span>
                                    {{ tag
                                        | link_to_remove_tag: tag
                                        | replace: 'title=', 'class="badge badge-secondary active m-1" title='
                                        | replace: '</a>', '<span class="ml-1" aria-hidden="true">&times;</span></a>'  }}
                                </li>
                            {% else %}
                                <li class="list-inline-item mx-0">
                                    {{ tag
                                        | link_to_add_tag: tag
                                        | replace: 'title=', 'class="badge badge-primary font-weight-500 font-size-90 m-1" title=' }}
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

        </div>
    </header>

    <div class="container overflow-hidden mb-n7">
        {% paginate blog.articles by section.settings.results_per_page %}

            <!-- Empty -->
            {% if blog.articles.size == 0 %}
                <p class="alert alert-warning">{{ 'blog.empty_html' | t }}</p>
            {% else %}

                <ul class="list-unstyled">

                    {% for article in blog.articles %}

                        <!-- Article -->
                        <article
                            class="blog-article row align-items-center mb-9">
                            <div class="col-lg mb-4 mb-lg-0">
                                <a class="d-block py-1 text-body text-decoration-none" href="{{ article.url }}">
                                    {% assign img_size = section.settings.img_width | append: 'x' | append: section.settings.img_height %}
                                    <img
                                        class="article-img img-fluid w-100 {% if section.settings.img_thumbnail %}img-thumbnail{% else %}rounded{% endif %}"
                                        data-src="{{ article.image | img_url: img_size, crop: 'center' }}"
                                        alt="{{ article.image.alt | escape }}"
                                        width="{{ section.settings.img_width }}"
                                        height="{{ section.settings.img_height }}"
                                        loading="lazy">
                                </a>
                            </div>
                            <div class="col-lg">

                                <!-- Article title -->
                                <h2 class="h3 blog-article-title">
                                    <a href="{{ article.url }}" class="">
                                        {{ article.title }}
                                    </a>
                                </h2>

                                <!-- Article meta -->
                                <p class="text-muted small">
                                    {% if section.settings.show_author %}
                                        {{ article.author }}
                                        <span class="opacity-75 mx-1"> | </span>
                                    {% endif %}
                                    {% if section.settings.show_date %}
                                        {{ article.created_at | time_tag: '%b %d, %Y' }}
                                        <span class="opacity-75 mx-1"> | </span>
                                    {% endif %}
                                    {% if section.settings.show_comments_count and blog.comments_enabled? %}
                                        {{ 'blog.comments.with_count' | t: count: article.comments_count }}
                                    {% endif %}
                                </p>

                                <!-- Article excerpt -->
                                {% if section.settings.show_excerpt %}
                                    <div class="rte mb-5">
                                        {% if article.excerpt.size > 0 %}
                                            {% if section.settings.excerpt_length != blank %}
                                                {{ article.excerpt | truncate: section.settings.excerpt_length }}
                                            {% else %}
                                                {{ article.excerpt }}
                                            {% endif %}
                                        {% else %}
                                            {{ article.content | truncate: section.settings.excerpt_length | default: 240 }}
                                        {% endif %}
                                    </div>
                                {% endif %}

                                <!-- Article readmore button -->
                                {% if section.settings.show_readmore %}
                                    <a href="{{ article.url }}" class="btn {{ section.settings.readmore_color }} {{ section.settings.readmore_size }}">
                                        {{ 'blog.readmore' | t }}
                                    </a>
                                {% endif %}

                            </div>
                        </article>
                    {% endfor %}
                </ul>

                <!-- Pagination -->
                {% render 'pagination' with paginate: paginate %}

            {% endif %}
        {% endpaginate %}
    </div>
</section>

{% schema %}
{
  "name": "Blog Pages",
  "settings": [
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "info": "Leave blank to disable",
      "default": "<p>Welcome to our blog, we hope it inspires you.</p>"
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Resultados por p\u00e1gina",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags",
      "default": true
    },
    {
      "type": "header",
      "content": "Blog post settings"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show Author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_comments_count",
      "label": "Show comments count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "text",
      "id": "excerpt_length",
      "label": "Excerpt lenght",
      "info": "Leave blank to show all text",
      "default": "240"
    },
    {
      "type": "checkbox",
      "id": "show_readmore",
      "label": "Read More button",
      "default": true
    },
    {
      "type": "select",
      "id": "readmore_color",
      "label": "Read More button color",
      "default": "btn-outline-primary",
      "options": [
        {
          "group": "Normal",
          "value": "btn-link",
          "label": "Link"
        },
        {
          "group": "Normal",
          "value": "btn-light",
          "label": "Light"
        },
        {
          "group": "Normal",
          "value": "btn-dark",
          "label": "Dark"
        },
        {
          "group": "Normal",
          "value": "button-buy",
          "label": "Primary"
        },
        {
          "group": "Normal",
          "value": "btn-secondary",
          "label": "Secondary"
        },
        {
          "group": "Normal",
          "value": "btn-success",
          "label": "Success"
        },
        {
          "group": "Normal",
          "value": "btn-danger",
          "label": "Danger"
        },
        {
          "group": "Normal",
          "value": "btn-warning",
          "label": "Warning"
        },
        {
          "group": "Normal",
          "value": "btn-info",
          "label": "Info"
        },
        {
          "group": "Outline",
          "value": "btn-outline-dark",
          "label": "Dark outline"
        },
        {
          "group": "Outline",
          "value": "btn-outline-primary",
          "label": "Primary outline"
        },
        {
          "group": "Outline",
          "value": "btn-outline-secondary",
          "label": "Secondary outline"
        },
        {
          "group": "Outline",
          "value": "btn-outline-success",
          "label": "Success outline"
        },
        {
          "group": "Outline",
          "value": "btn-outline-danger",
          "label": "Danger outline"
        },
        {
          "group": "Outline",
          "value": "btn-outline-warning",
          "label": "Warning outline"
        },
        {
          "group": "Outline",
          "value": "btn-outline-info",
          "label": "Info ouline"
        }
      ]
    },
    {
      "type": "select",
      "id": "readmore_size",
      "label": "Read more button size",
      "options": [
        {
          "value": "btn-sm",
          "label": "Small"
        },
        {
          "value": "",
          "label": "Normal"
        },
        {
          "value": "btn-lg",
          "label": "Large"
        }
      ]
    },
    {
      "type": "text",
      "id": "img_width",
      "label": "Image width (px)",
      "default": "720"
    },
    {
      "type": "text",
      "id": "img_height",
      "label": "Image height (px)",
      "default": "405"
    },
    {
      "type": "checkbox",
      "id": "img_thumbnail",
      "label": "Image border",
      "default": true
    }
  ]
}
{% endschema %}
