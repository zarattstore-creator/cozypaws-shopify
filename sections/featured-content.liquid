{% assign pt =  section.settings.padding_top | prepend: 'pt-' %}
{% assign pb =  section.settings.padding_bottom | prepend: 'pb-' %}
{% assign mt =  section.settings.margin_top | prepend: 'mt-' %}
{% assign mb =  section.settings.margin_bottom | prepend: 'mb-' %}

{% capture bg_img %}
    {% unless section.settings.bg_img == blank %}
        {{ section.settings.bg_img | img_url: '1600x900', crop: 'center' }}
    {% endunless %}
{% endcapture %}

{% capture max_width %}
    {% unless section.settings.max_width == blank %}
        max-width: {{ section.settings.max_width | append: 'px' }};
    {% endunless %}
{% endcapture %}

<div
    id="featured-content-{{ section.id }}"
    class="featured-content {{ pt }} {{ pb }} {{ mt }} {{ mb }} {% if bg_img == blank %} {{ section.settings.bg_color }} {% endif %} {% if section.settings.fixed_bg_img %}background-attachment-fixed{% endif %}"
    data-lazy-img="{{ bg_img }}">

    <div class="featured-content-border-top"></div>

    <div class="container {{ section.settings.alignment }}">

        <div
            class="featured-content-inner-container {% unless section.settings.animate_class == blank %}animate__animated{% endunless %}"
            data-animate="{{ section.settings.animate_class }}">

            <div
                class="mx-auto"
                style="{{ max_width }}">

                <!-- Title -->
                {% if section.settings.title != blank %}
                    <h2 class="title {{ section.settings.title_size }}">
                        {{ section.settings.title }}
                    </h2>
                {% endif %}

                <!-- Description -->
                {% if section.settings.description != blank %}
                    <div class="description rte {% if section.settings.description_lead %}lead{% endif %}">
                        {{ section.settings.description }}
                    </div>
                {% endif %}

                <!-- Button -->
                {% if section.settings.button_url != blank %}
                    <a href="{{ section.settings.button_url }}" class="btn mt-5 mb-1 {{ section.settings.btn_color }} {{ section.settings.btn_size }}">
                        {{ section.settings.button_text }}
                    </a>
                {% endif %}

            </div>
        </div>
    </div>

    <div class="featured-content-border-bottom"></div>

</div>

{% schema %}
{
    "name": {
     "en": "Featured Content",
     "pt-BR": "Conteúdo em destaque"
    },
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": {
             "en": "Title",
             "pt-BR": "Título"
            },
            "default": {
             "en": "Featured Content",
             "pt-BR": "Conteúdo em destaque"
            }
        },
        {
            "type": "richtext",
            "id": "description",
            "label": {
             "en": "Description",
             "pt-BR": "Descrição"
            },
            "default": {
             "en": "<p>Use this text to share information about your brand with your customers. Describe a product, share ads, or welcome customers to your store.</p>",
             "pt-BR": "<p>Use este texto para compartilhar informações sobre sua marca com seus clientes. Descreva um produto, compartilhe anúncios ou dê as boas-vindas aos clientes em sua loja.</p>"
            }
        },
        {
            "type": "url",
            "id": "button_url",
            "label": {
             "en": "Button URL",
             "pt-BR": "URL do botão"
            },
            "info": {
             "en": "Leave blank to disable the button",
             "pt-BR": "Deixe em branco para desativar o botão"
            }
        },
        {
            "type": "text",
            "id": "button_text",
            "label": {
             "en": "Button Text",
             "pt-BR": "Texto do botão"
            },
            "default": {
             "en": "Learn More",
             "pt-BR": "Saber mais"
            }
        },
        {
            "type": "header",
            "content": {
             "en": "General Settings",
             "pt-BR": "Configurações Gerais"
            }
        },
        {
            "type": "select",
            "id": "bg_color",
            "label": {
             "en": "Background color",
             "pt-BR": "Cor do fundo"
            },
            "default": "bg-light",
            "options": [
                { "group": "Light", "value": "bg-white", "label": "White" },
                { "group": "Light", "value": "bg-light", "label": "Light" },
                { "group": "Dark", "value": "bg-dark", "label": "Dark" },
                { "group": "Dark", "value": "bg-primary", "label": "Primary" },
                { "group": "Dark", "value": "bg-secondary", "label": "Secondary" },
                { "group": "Gradient", "value": "bg-dark-gradient", "label": "Dark" },
                { "group": "Gradient", "value": "bg-primary-gradient", "label": "Primary" },
                { "group": "Gradient", "value": "bg-secondary-gradient", "label": "Secondary" },
                { "group": "Gradient", "value": "bg-custom-gradient", "label": "Custom" }
            ]
        },
        {
            "type": "image_picker",
            "id": "bg_img",
            "label": {
             "en": "Background Image",
             "pt-BR": "Imagem do fundo"
            }
        },
        {
            "type": "checkbox",
            "id": "fixed_bg_img",
            "label": {
             "en": "Fixed background image",
             "pt-BR": "Imagem do fundo fixa"
            },
            "default": true
        },
        {
            "type": "select",
            "id": "alignment",
            "label": {
             "en": "Alignment",
             "pt-BR": "Alinhamento"
            },
            "options": [
                { "value": "text-left", "label": {"en": "Left","pt-BR": "Esquerda"} },
                { "value": "text-center", "label": {"en": "Center","pt-BR": "Centro"} },
                { "value": "text-right", "label": {"en": "Right","pt-BR": "Direita"} }
            ],
            "default": "text-center"
        },
        {
            "type": "text",
            "id": "max_width",
            "label": {
             "en": "Maximum width (px)",
             "pt-BR": "Largura máxima (px)"
            },
            "info": {
             "en": "Leave empty to disable it.",
             "pt-BR": "Deixe vazio para desativá-lo."
            },
            "default": "720"
        },
        {
            "type": "select",
            "id": "title_size",
            "label": {
             "en": "Title Size",
             "pt-BR": "Tamanho do título"
            },
            "default": "h2",
            "options": [
                { "value": "h1", "label": "H1" },
                { "value": "h2", "label": "H2" },
                { "value": "h3", "label": "H3" },
                { "value": "h4", "label": "H4" },
                { "value": "h5", "label": "H5" },
                { "value": "h6", "label": "H6" }
            ]
        },

        {
            "type": "checkbox",
            "id": "description_lead",
            "label": {
             "en": "Description lead",
             "pt-BR": "Descrição principal"
            },
            "default": false
        },
        {
            "type": "select",
            "id": "btn_color",
            "label": {
               "en": "Button color",
               "pt-BR": "Cor do botão"
             },
            "default": "btn-primary",
            "options": [
                { "group": "Normal", "value": "btn-link", "label": {"en": "Link","pt-BR": "Link"} },
                { "group": "Normal", "value": "btn-light", "label": {"en": "Light","pt-BR": "Claro"} },
                { "group": "Normal", "value": "btn-dark", "label": {"en": "Dark","pt-BR": "Escuro"} },
                { "group": "Normal", "value": "btn-primary", "label": {"en": "Primary","pt-BR": "Primário"} },
                { "group": "Normal", "value": "btn-secondary", "label": {"en": "Secondary","pt-BR": "Secundário"} },
                { "group": "Normal", "value": "btn-success", "label": {"en": "Success","pt-BR": "Sucesso"} },
                { "group": "Normal", "value": "btn-danger", "label": {"en": "Danger","pt-BR": "Perigo"} },
                { "group": "Normal", "value": "btn-warning", "label": {"en": "Warning","pt-BR": "Aviso"} },
                { "group": "Normal", "value": "btn-info", "label": {"en": "Info","pt-BR": "Informações"} },
                { "group": "Outline", "value": "btn-outline-dark", "label": {"en": "Dark Outline","pt-BR": "Contorno escuro"} },
                { "group": "Outline", "value": "btn-outline-primary", "label": {"en": "Primary Outline","pt-BR": "Contorno cor do primário"} },
                { "group": "Outline", "value": "btn-outline-secondary", "label": {"en": "Secondary Outline","pt-BR": "Contorno cor do secundário"} },
                { "group": "Outline", "value": "btn-outline-success", "label": {"en": "Success Outline","pt-BR": "Contorno do sucesso"} },
                { "group": "Outline", "value": "btn-outline-danger", "label": {"en": "Danger Outline","pt-BR": "Contorno cor do perigo"} },
                { "group": "Outline", "value": "btn-outline-warning", "label": {"en": "Warning Outline","pt-BR": "Contorno cor do aviso"} },
                { "group": "Outline", "value": "btn-outline-info", "label": {"en": "Info Outline","pt-BR": "Contorno cor do informações"} }
            ]
        },
        {
            "type": "select",
            "id": "btn_size",
            "label": {
               "en": "Button size",
               "pt-BR": "Tamanho do botão"
             },

             "options":[
                {
                   "value":"btn-sm",
                   "label":{
                     "en": "Small",
                     "pt-BR": "Pequeno"
                   }
                },
                {
                   "value":"",
                   "label":{
                     "en": "Normal",
                     "pt-BR": "Normal"
                   }
                },
                {
                   "value":"btn-lg",
                   "label":{
                     "en": "Large",
                     "pt-BR": "Grande"
                   }
                }
             ]
        },
        {
            "type": "header",
            "content": {
             "en": "Spacing",
             "pt-BR": "Espaçamento"
            },
            "info": {
             "en": "Based on Bootstrap Spacing Utility Classes [Learn More](https://getbootstrap.com/docs/4.5/utilities/spacing/)",
             "pt-BR": "Com base nas classes do utilitário de espaçamento Bootstrap [Saiba mais](https://getbootstrap.com/docs/4.5/utilities/spacing/)"
            }
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": {
             "en": "Padding Top",
             "pt-BR": "Espaçamento superior"
            },
            "min": 0,
            "max": 15,
            "step": 1,
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": {
             "en": "Padding bottom",
             "pt-BR": "Espaçamento inferior"
            },
            "min": 0,
            "max": 15,
            "step": 1,
            "default": 0
        },
        {
            "type": "range",
            "id": "margin_top",
            "label": {
             "en": "Margin top",
             "pt-BR": "Margem superior"
            },
            "min": 0,
            "max": 15,
            "step": 1,
            "default": 0
        },
        {
            "type": "range",
            "id": "margin_bottom",
            "label": {
             "en": "Margin bottom",
             "pt-BR": "Margem inferior"
            },
            "min": 0,
            "max": 15,
            "step": 1,
            "default": 9
        }
    ],
    "presets": [
        {
            "name": {
             "en": "Featured Content",
             "pt-BR": "Conteúdo em destaque"
            },
            "category": {
             "en": "Text",
             "pt-BR": "Texto"
            }
        }
    ]
}
{% endschema %}
