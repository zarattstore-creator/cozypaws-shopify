{% if section.settings.topbar_display %}
    {% if template.name == 'index' or section.settings.show_on_all_pages %}
        <div id="topbar" class="py-2" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
            <div class="{% if section.settings.container %}container{% else %}container-fluid{% endif %}">
                <div class="row justify-content-center">
                    <div class="col-12 text-center small">
                        {{ section.settings.announcement_text }}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endif %}
{% schema %}
{
  "name": "Top Bar",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "topbar_display",
      "label": "Show top bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_all_pages",
      "label": "Show on all pages",
      "info": "If disabled, shows only on homepage.",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#185C54"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "container",
      "label": "Container",
      "default": true
    },
    {
      "type": "header",
      "content": "Announcement"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Free U.S. shipping on qualifying orders"
    }
  ]
}
{% endschema %}
