{% assign show_announcement = false %}

{% if section.settings.announcement_homepage == false or template.name == 'index' %}
    {% assign show_announcement = true %}
{% endif %}

{% if section.settings.topbar_display and show_announcement %}
    {% if section.settings.topbar_dis%}
        <div style="color:{{ section.settings.toplink}}!important ;background: var(--color-light);"  id="topbar" class="py-1">
            <div class="{% if section.settings.container %}container{% else %}container-fluid{% endif %}">
                <div class="row justify-content-between align-items-center">


                    <!-- Announcement -->
                    {% if show_announcement %}
                        <div
                            id="announcement"
                            class="col-12 rte text-center small w-100 {% if section.settings.announcement_animate and template.name == 'index' %}animate__animated {{ section.settings.announcement_animate_name }}{% endif %}">
                            {% capture coundown %}
                                <span style=" font-size: 16px; background: var(--color-dark); border-radius: 10px; padding-left: 6px; padding-right: 6px; font-weight: bold" id="timecont"></span>
                                <script>
                                    // Update the count down every 1 second
                                    const timecont = setInterval(function () {
                                        document.getElementById("timecont").innerHTML = moment.utc(moment().endOf('day').diff()).format('HH:mm:ss');
                                    }, 1000);
                                </script>
                            {% endcapture %}
                            {{ section.settings.announcement_content | replace: '[timecont]', coundown }}
                        </div>

                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}

    <!-- Ativar imagem -->
     {% if section.settings.anuncio_img and section.settings.imgdesk and section.settings.imgmb %}
        <section class="d-flex justify-content-center" style="background: {{ section.settings.img_fundo}};">
            <!-- Imagem desktop -->
             <a  class="d-none d-sm-none d-md-block d-lg-block" {% if section.settings.url_i %} href="{{ section.settings.url_i}} {% endif %}">
                    <img src="{{ section.settings.imgdesk | img_url: '1110x44' }}" class="img-responsive" >
             </a>
            <!-- Imagem mobile -->
             <a  class="d-md-none" {% if section.settings.url_i %} href="{{ section.settings.url_i }}" {% endif %}>
                <img src="{{ section.settings.imgmb| img_url: '760x44' }}" class="img-responsive">
            </a>
        </section>
     {% endif %}
{% endif %}
{% schema %}
{
    "name": {
         "en": "Top Bar",
         "pt-BR": "Barra do topo"
       },
    "tag": "section",
    "settings": [
        {
            "type": "checkbox",
            "id": "topbar_display",
            "label":{
             "en": "Show top bar",
             "pt-BR": "Exibir barra superior"
            },
            "info": {
             "en": "Note: If you disable this setting, it will completely hide the top bar, regardless of any other settings you have below.",
             "pt-BR": "Nota: Se você desabilitar esta configuração, ela ocultará completamente a barra superior, independentemente das outras configurações que você tenha abaixo."
            },
            "default": true
        },
        {
            "type": "checkbox",
            "id": "announcement_homepage",
            "label": {
             "en": "Show only on homepage",
             "pt-BR": "Mostrar apenas na página inicial"
            },
            "default": false
        },
        {
            "type": "checkbox",
            "id": "container",
            "label": "Container",
            "default": true
        },
        {
            "type": "color",
            "id": "topbg",
            "label": {
             "en": "Background color",
             "pt-BR": "Cor do fundo"
            },
            "default": "#000"
        },

        {
            "type": "color",
            "id": "toplink",
            "label": {
             "en": "Text color",
             "pt-BR": "Cor do texto"
            },
            "default": "#fff"
        },
        {
            "type": "header",
            "content": {
             "en": "Announcement",
             "pt-BR": "Anúncio"
            }
        },
        {
            "type": "checkbox",
            "id": "topbar_dis",
            "label": {
             "en": "Show announcement",
             "pt-BR": "Exibir anúncio"
            },
            "default": true
        },
        {
            "type": "textarea",
            "id": "announcement_content",
            "label": "Texto",
            "info": {
             "en": "To add a countdown (can be set below), add [timecont] anywhere in your text.",
             "pt-BR": "Para adicionar uma contagem regressiva (pode ser definida abaixo), adicione [timecont] em qualquer lugar do seu texto."
            },
            "default": {
             "en": "Use <strong>VIP2021</strong> to get a 20% discount. The offer expires in: [timecont]" ,
             "pt-BR": "Use <strong>VIP2021</strong> para obter um desconto de 20%. A oferta expira em: [timecont] "
            }
        },
        {
            "type": "checkbox",
            "id": "announcement_animate",
            "label": {
             "en": "Announcement animate",
             "pt-BR": "Animação do Announcement"
            },
            "default": true
        },
        {
            "type": "select",
            "id": "announcement_animate_name",
            "label": {
             "en": "Animation style",
             "pt-BR": "Estilo da animação"
            },
            "info": {
             "en": "[Learn more](https://animate.style/)",
             "pt-BR": "[Saber mais](https://animate.style/)"
            },
            "default": "animate__flash",
            "options": [
                { "value": "animate__bounce", "label": "Bounce" },
                { "value": "animate__flash", "label": "Flash" },
                { "value": "animate__pulse", "label": "Pulse" },
                { "value": "animate__rubberBand", "label": "rubberBand" },
                { "value": "animate__shakeX", "label": "ShakeX" },
                { "value": "animate__shakeY", "label": "ShakeY" },
                { "value": "animate__headShake", "label": "headShake" },
                { "value": "animate__swing", "label": "Swing" },
                { "value": "animate__tada", "label": "Tada" },
                { "value": "animate__wobble", "label": "Wobble" },
                { "value": "animate__jello", "label": "Jello" },
                { "value": "animate__heartBeat", "label": "heartBeat" }
            ]
        },
        {
            "type": "header",
            "content": {
             "en": "Image ad",
             "pt-BR": "Anúncio em imagem"
            }
        },
        {
            "type": "checkbox",
            "id": "anuncio_img",
            "label": {
             "en": "Image ad",
             "pt-BR": "Anúncio em imagem"
            },
            "default": true,
            "info": {
             "en": "Select the two images to show.",
             "pt-BR": "Selecione as duas imagens para mostrar."
            }
        },
        {
            "type": "color",
            "id": "img_fundo",
            "label": {
             "en": "Background color",
             "pt-BR": "Cor do fundo"
            },
            "default": "#000"
        },
        {
            "type": "image_picker",
            "id": "imgdesk",
            "info": {
             "en": "Suggestion (1110x44).",
             "pt-BR": "Sugestão (1110x44)."
            },
            "label": {
             "en": "Desktop Image",
             "pt-BR": "Imagem Desktop"
            }
        },
        {
            "type": "image_picker",
            "id": "imgmb",
            "info": {
             "en": "Suggestion (460x44).",
             "pt-BR": "Sugestão (460x44)."
            },
            "label": "Imagem Mobile"
        },
        {
            "type": "url",
            "id": "url_i",
            "info": {
             "en": "Leave blank to disable",
             "pt-BR": "Deixe em branco para desativar"
            },
            "label": {
             "en": "Ad link",
             "pt-BR": "Link do anúncio"
            }
        }
    ]
}
{% endschema %}
