{% assign pt =  section.settings.padding_top | prepend: 'pt-' %}
{% assign pb =  section.settings.padding_bottom | prepend: 'pb-' %}
{% assign mt =  section.settings.margin_top | prepend: 'mt-' %}
{% assign mb =  section.settings.margin_bottom | prepend: 'mb-' %}

<section
    id="brands-{{ section.id }}"
    class="brands {% if section.settings.bg_light %}bg-light{% endif %} {{ pt }} {{ pb }} {{ mt }} {{ mb }}">
    <div class="{% if section.settings.container %} container {% else %} container-fluid {% endif %}">

        <!-- Title -->
        <h2 class="title mb-1 {{ section.settings.title_size }} {{ section.settings.title_alignment }}">
            {{ section.settings.title | escape }}
        </h2>

        <!-- Description -->
        {% if section.settings.description != blank %}
            <div class="description rte  text-muted mb-6 {{ section.settings.title_alignment }}">
                {{ section.settings.description }}
            </div>
        {% endif %}

        <ul
            class="brand-list text-center list-unstyled my-0"
            data-speed="{{ section.settings.speed }}">

            {% for block in section.blocks %}
                <li class="d-inline-block p-1">
                    {% if block.settings.url != blank %}
                        <a href="{{ block.settings.url }}">
                    {% endif %}

                    {% assign img_size = section.settings.img_height | prepend: 'px' %}
                    <img
                        class="img-fluid"
                        data-src="{{ block.settings.image | img_url: img_size, crop: 'center' }}"
                        alt="{{ block.settings.image.alt }}"
                        width="{{ section.settings.img_height | times: block.settings.image.aspect_ratio | round }}"
                        height="{{ section.settings.img_height }}"
                        loading="lazy">

                    {% if block.settings.url != blank %}
                        </a>
                    {% endif %}
                </li>
            {% else %}
                {% for i in (1..16) %}
                    <li class="d-inline-block p-2">
                        <a href="#">
                            <div style="width: {{ section.settings.img_height | append: 'px' }}">
                                {{ 'image' | placeholder_svg_tag: 'placeholder-svg img-thumbnail img-fluid' }}
                            </div>
                        </a>
                    </li>
                {% endfor %}
            {% endfor %}

        </ul>
    </div>
</section>

{% schema %}
{
  "name": "Brands",
  "settings": [
    {
      "type": "header",
      "content": "Brands"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Brands you already love"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Write something attractive for this section.</p>"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "default": "h4",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ]
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title alignment",
      "options": [
        {
          "value": "text-left",
          "label": "Left"
        },
        {
          "value": "text-center",
          "label": "Center"
        },
        {
          "value": "text-right",
          "label": "Right"
        }
      ],
      "default": "text-center"
    },
    {
      "type": "header",
      "content": "General settings"
    },
    {
      "type": "checkbox",
      "id": "bg_light",
      "label": "Light background",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "container",
      "label": "Container",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Slider speed",
      "min": 50,
      "max": 500,
      "step": 50,
      "default": 50
    },
    {
      "type": "text",
      "id": "img_height",
      "label": "Image height (px)",
      "default": "90"
    },
    {
      "type": "header",
      "content": "Spacing",
      "info": "Based on Bootstrap Spacing Utility Classes [Learn More](https://getbootstrap.com/docs/4.5/utilities/spacing/)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 9
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brands",
      "category": "image"
    }
  ]
}
{% endschema %}
