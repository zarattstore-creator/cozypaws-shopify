{%- comment -%}
    Spacing
{%- endcomment -%}
{% assign pt =  section.settings.padding_top | prepend: 'pt-' %}
{% assign pb =  section.settings.padding_bottom | prepend: 'pb-' %}
{% assign mt =  section.settings.margin_top | prepend: 'mt-' %}
{% assign mb =  section.settings.margin_bottom | prepend: 'mb-' %}



{%- comment -%}
    Begin section
{%- endcomment -%}
<section id="infobar" style=" background: {% if section.settings.bg_cor %}{{ section.settings.bg_cor }} {% endif %}; color: {% if section.settings.infolink %}{{ section.settings.infolink }} {% endif %} " >
    <div class=" {{ pt }} {{ pb }} {{ mt }} {{ mb }}{% if section.settings.container %} container {% else %} container-fluid {% endif %}">

        <ul class="list-unstyled mx-n3 mb-0 row row-cols-{{ section.settings.row_mobile }} row-cols-md-{{ section.settings.row_tablet }} row-cols-lg-{{ section.settings.row_desktop }}">

            {% for block in section.blocks %}
                <li
                    class="infobar-item px-3 py-4 d-flex align-items-center {% unless section.settings.animate_class == blank %}animate__animated animate__fast{% endunless %} {{ forloop.index | prepend: 'enter-view-step-' }}"
                    data-animate="{{ section.settings.animate_class }}">

                    <!-- Icon -->
                    <div class="mr-4" style="color: var(--color-dark);">
                        {{ block.settings.icon }}
                    </div>

                    <div>
                         <!-- Title -->
                         <h3 class="{{ section.settings.title_size }} {{ title_color }}" style="font-weight: 700">
                            {{ block.settings.title }}
                        </h3>

                        <!-- Description -->
                        <div class="rte {{ desc_color }}">
                            {{ block.settings.description }}
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>
</section>

{
  "name": "Benefit Bar",
  "class": "overflow-hidden",
  "settings": [
    {
      "type": "color",
      "id": "bg_cor",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "infolink",
      "label": "Text color",
      "default": "#24322F"
    },
    {
      "type": "checkbox",
      "id": "container",
      "label": "Wrap container",
      "default": true
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "default": "h6",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ]
    },
    {
      "type": "text",
      "id": "animate_class",
      "label": "Animation",
      "info": "Animation effect when scrolling. It only once. Empty to disable [Learn More](http://animate.style/). Suggested:animate__zoomInUp"
    },
    {
      "type": "header",
      "content": "Rows"
    },
    {
      "type": "range",
      "id": "row_mobile",
      "label": "Items per Line / Mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "row_tablet",
      "label": "Items per Line / Tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "row_desktop",
      "label": "Items per Line / Desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Spacing",
      "info": "Based on Bootstrap Spacing Utility Classes [Learn More](https://getbootstrap.com/docs/4.5/utilities/spacing/)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Content",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "Icon",
          "info": "Copy and paste any SVG code from the recommended [bootstrap icons] (https://icons.getbootstrap.com/) library."
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon color",
          "default": "#247F72"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
