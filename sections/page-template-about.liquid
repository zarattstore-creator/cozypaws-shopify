<article>

    <!-- Header -->
    <header
        id="page-header"
        class="page-header text-center mb-7">
        <div class="container">

            <h3 class="">
                {{ page.title }}
            </h3>

            {% unless section.settings.description == blank %}
                <div class="rte lead text-muted">
                    {{ section.settings.description }}
                </div>
            {% endunless %}

        </div>
    </header>

    <!-- Main image -->
    {% unless section.settings.main_image == blank %}
        <div class="container">
            {% assign image_size = section.settings.main_image_width | append: 'x' | append: section.settings.main_image_height %}
            <img
                class="img-fluid mb-6 {% if section.settings.main_image_img_thumbnail %}img-thumbnail{% else %}rounded{% endif %}"
                data-src="{{ section.settings.main_image | img_url: image_size, crop: 'center' }}"
                loading="lazy"
                alt="{{ section.settings.main_image.alt }}"
                width="{{ section.settings.main_image_width }}"
                height="{{ section.settings.main_image_height }}">
        </div>
    {% endunless %}

    <!-- Page content -->
    <div class="about-page-content mb-9">
        <div class="container" style="{% unless section.settings.page_max_width == blank %}max-width: {{ section.settings.page_max_width }}px;{% endunless %}">
            {{ page.content }}
        </div>
    </div>

    <!-- Team blocks -->
    {% if section.settings.enable_team_blocks %}
        <div class="mb-9 {% if section.settings.team_bg_light %}bg-light pt-8 pb-6 {% else %} {% endif %}">
            <div class="container">
                <h2 class="{{ section.settings.team_title_alignment }}">
                    {{ section.settings.team_title }}
                </h2>
                {% if section.settings.description != blank %}
                    <div class="rte text-muted mb-4 {{ section.settings.team_title_alignment }}">
                        {{ section.settings.team_description }}
                    </div>
                {% endif %}
                <ul class="team-list list-unstyled mb-0 row row-cols-{{ section.settings.team_row_mobile }} row-cols-md-{{ section.settings.team_row_tablet }} row-cols-lg-{{ section.settings.team_row_desktop }}">
                    {% for block in section.blocks %}
                        {% if block.type == 'team' %}
                            <li class="team px-2 py-4 text-center">
                                {% assign image_size = section.settings.team_image_width | append: 'x' | append: section.settings.team_image_height %}
                                <img
                                    class="img-fluid mb-3 {% if section.settings.team_image_img_thumbnail %}img-thumbnail{% else %}rounded{% endif %}"
                                    data-src="{{ block.settings.team_image | img_url: image_size, crop: 'center' }}"
                                    loading="lazy"
                                    alt="{{ block.settings.team_image.alt }}"
                                    width="{{ section.settings.team_image_width }}"
                                    height="{{ section.settings.team_image_height }}">
                                <h3 class="h5 mb-1">
                                    {{ block.settings.team_name | escape }}
                                </h3>
                                {% unless block.settings.team_description == blank %}
                                    <div class="rte text-muted">
                                        {{ block.settings.team_description }}
                                    </div>
                                {% endunless %}
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
        </div>
    {% endif %}

    <!-- Text Blocks -->
    <div class="container">
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 justify-content-center mb-8">

            {% for block in section.blocks %}
                {% if block.type == 'text' %}
                    <div class="my-2 text-center">
                        <h3 class="h5">
                            {{ block.settings.title | escape }}
                        </h3>
                        <div class="rte">
                            {{ block.settings.description }}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}

        </div>
    </div>

    <!-- Bottom notice -->
    {% unless section.settings.bottom_notice == blank %}
        <div class="container">
            <div class="rte alert {{ section.settings.bottom_notice_alert_style }}">
                {{ section.settings.bottom_notice | replace: '<p>', '<p class="mb-0">' }}
            </div>
        </div>
    {% endunless %}

</article>

{% schema %}
{
  "name": "Sobre",
  "settings": [
    {
      "type": "header",
      "content": "General settings"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Inspired by simplicity, driven by performance.</p>",
      "info": "Leave blank to disable"
    },
    {
      "type": "text",
      "id": "page_max_width",
      "label": "Maximum page width (px)",
      "info": "Leave blank to disable",
      "default": "767"
    },
    {
      "type": "header",
      "content": "Main image"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "main_image_width",
      "label": "Image width (px)",
      "default": "1200"
    },
    {
      "type": "text",
      "id": "main_image_height",
      "label": "Image height (px)",
      "default": "600"
    },
    {
      "type": "checkbox",
      "id": "main_image_img_thumbnail",
      "label": "Image border",
      "default": true
    },
    {
      "type": "header",
      "content": "Team"
    },
    {
      "type": "checkbox",
      "id": "enable_team_blocks",
      "label": "Enable team locks",
      "default": true
    },
    {
      "type": "text",
      "id": "team_title",
      "label": "Title",
      "default": "Meet the Team"
    },
    {
      "type": "richtext",
      "id": "team_description",
      "label": "Description",
      "default": "<p>We are passionate about providing you with the most..</p>"
    },
    {
      "type": "checkbox",
      "id": "team_bg_light",
      "label": "Light background",
      "default": true
    },
    {
      "type": "select",
      "id": "team_title_alignment",
      "label": "Title alignment",
      "default": "text-center",
      "options": [
        {
          "value": "text-left",
          "label": "Left"
        },
        {
          "value": "text-center",
          "label": "Center"
        },
        {
          "value": "text-right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "text",
      "id": "team_image_width",
      "label": "Image width (px)",
      "default": "480"
    },
    {
      "type": "text",
      "id": "team_image_height",
      "label": "Image height (px)",
      "default": "480"
    },
    {
      "type": "checkbox",
      "id": "team_image_img_thumbnail",
      "label": "Image border",
      "default": true
    },
    {
      "type": "range",
      "id": "team_row_mobile",
      "label": "Team per row / Mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "team_row_tablet",
      "label": "Team per row / Tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "team_row_desktop",
      "label": "Team per row / Desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Bottom warning"
    },
    {
      "type": "richtext",
      "id": "bottom_notice",
      "label": "Warning button",
      "default": "<p>Questions? <a href=\"/pages/contact\">Contact Us</a></p>"
    },
    {
      "type": "select",
      "id": "bottom_notice_alert_style",
      "label": "Bottom notice alert style",
      "default": "alert-info",
      "options": [
        {
          "value": "alert-light",
          "label": "Light"
        },
        {
          "value": "alert-dark",
          "label": "Dark"
        },
        {
          "value": "alert-info",
          "label": "Info"
        },
        {
          "value": "alert-success",
          "label": "Success"
        },
        {
          "value": "alert-warning",
          "label": "Warning"
        },
        {
          "value": "alert-danger",
          "label": "Danger"
        },
        {
          "value": "alert-primary",
          "label": "Primary"
        },
        {
          "value": "alert-secondary",
          "label": "Secondary"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "team",
      "name": "Team",
      "settings": [
        {
          "type": "image_picker",
          "id": "team_image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "team_name",
          "label": "Name"
        },
        {
          "type": "richtext",
          "id": "team_description",
          "label": "Description"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "default": {
    "settings": {},
    "blocks": [
      {
        "type": "text",
        "settings": {
          "title": "Working days",
          "description": "<p>From monday to friday</p>"
        }
      },
      {
        "type": "text",
        "settings": {
          "title": "Working hours",
          "description": "<p>9 am to 5 pm</p>"
        }
      },
      {
        "type": "text",
        "settings": {
          "title": "Prefer to call?",
          "description": "<p><a href=\"tel:63 9 0000-0000\" title=\"tel:63 9 0000-0000\">+63 9 0000-0000</a></p>"
        }
      }
    ]
  }
}
{% endschema %}
