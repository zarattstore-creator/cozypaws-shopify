            "type": "richtext",
            "id": "description",
            "label": {
             "en": "Description",
             "pt-BR": "Descrição"
            },
            "default": {
             "en": "<p>Inspired by simplicity, driven by performance.</p>",
             "pt-BR": "<p>Inspirado pela simplicidade, impulsionado pelo desempenho.</p>"
            },
            "info": {
             "en": "Leave blank to disable",
             "pt-BR": "Deixe em branco para desativar"
            }
        },
        {
            "type": "text",
            "id": "page_max_width",
            "label": {
             "en": "Maximum page width (px)",
             "pt-BR": "Largura máxima da página (px)"
            },
            "info": {
             "en": "Leave blank to disable",
             "pt-BR": "Deixe em branco para desativar"
            },
            "default": "767"
        },
        {
            "type": "header",
            "content": {
             "en": "Main image",
             "pt-BR": "imagem principal"
            }
        },
        {
            "type": "image_picker",
            "id": "main_image",
            "label": {
             "en": "Image",
             "pt-BR": "Imagem"
            }
        },
        {
            "type": "text",
            "id": "main_image_width",
            "label": {
