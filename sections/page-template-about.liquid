             "pt-BR": "Fundo claro"
            },
            "default": true
        },
        {
            "type": "select",
            "id": "team_title_alignment",
            "label": {
             "en": "Title alignment",
             "pt-BR": "Alinhamento do título"
            },
            "default": "text-center",
            "options": [
                { "value": "text-left", "label": {"en": "Left","pt-BR": "Esquerda"} },
                { "value": "text-center", "label": {"en": "Center","pt-BR": "Centro"} },
                { "value": "text-right", "label": {"en": "Right","pt-BR": "Direita"} }
            ]
        },
        {
            "type": "text",
            "id": "team_image_width",
            "label": {
               "en": "Image width (px)",
               "pt-BR": "Largura da imagem (px)"
             },
            "default": "480"
        },
        {
            "type": "text",
            "id": "team_image_height",
            "label": {
               "en": "Image height (px)",
               "pt-BR": "Altura da imagem (px)"
             },
            "default": "480"
        },
        {
            "type": "checkbox",
            "id": "team_image_img_thumbnail",
            "label": {
               "en": "Image border",
               "pt-BR": "Borda da imagem"
             },
            "default": true
