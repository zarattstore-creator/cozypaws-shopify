            },
            "default": true
        },
        {
            "type": "text",
            "id": "team_title",
            "label": {
             "en": "Title",
             "pt-BR": "Título"
            },
            "default": {
             "en": "Meet the Team",
             "pt-BR": "Conheça o time"
            }
        },
        {
            "type": "richtext",
            "id": "team_description",
            "label": {
             "en": "Description",
             "pt-BR": "Descrição"
            },
            "default": {
             "en": "<p>We are passionate about providing you with the most..</p>",
             "pt-BR": "<p>Somos apaixonados por fornecer-lhe o máximo..</p>"
            }
        },
        {
            "type": "checkbox",
            "id": "team_bg_light",
            "label": {
