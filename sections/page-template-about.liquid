        {
            "type": "range",
            "id": "team_row_desktop",
            "label": {
             "en": "Team per row / Desktop",
             "pt-BR": "Equipe por linha / Desktop"
            },
            "min": 1,
            "max": 6,
            "step": 1,
            "default": 4
        },
        {
            "type": "header",
