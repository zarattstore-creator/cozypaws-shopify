               "pt-BR": "Altura da imagem (px)"
             },
            "default": "600"
        },
        {
            "type": "checkbox",
            "id": "main_image_img_thumbnail",
            "label": {
               "en": "Image border",
               "pt-BR": "Borda da imagem"
             },
            "default": true
        },
        {
            "type": "header",
            "content": {
             "en": "Team",
             "pt-BR": "Equipe"
            }
        },
        {
            "type": "checkbox",
