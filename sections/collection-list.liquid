            },
            "info": {
             "en": "Screen width: <=1200px",
             "pt-BR": "Largura da tela: <=1200px"
            },
            "min": 1,
            "max": 6,
            "step": 1,
            "default": 3
        },
        {
            "type": "range",
            "id": "breakpoint_xl",
