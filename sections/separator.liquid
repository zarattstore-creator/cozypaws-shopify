<div class="{% if section.settings.container %} container {% else %} container-fluid {% endif %}">
    <hr class="mt-{{ section.settings.margin_top }} mb-{{ section.settings.margin_bottom }}">
</div>
  
{% schema %}
{
  "name": "Separator",
  "settings": [
    {
      "type": "checkbox",
      "id": "container",
      "label": "Wrap container",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing",
      "info": "Based on Bootstrap Spacing Utility Classes [Learn More](https://getbootstrap.com/docs/4.5/utilities/spacing/)"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 9
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 9
    }
  ],
  "presets": [
    {
      "name": "Separator",
      "category": "image"
    }
  ]
}
{% endschema %}