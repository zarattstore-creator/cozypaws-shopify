{% if section.settings.enable_section %}
    {% assign pt =  section.settings.padding_top | prepend: 'pt-' %}
    {% assign pb =  section.settings.padding_bottom | prepend: 'pb-' %}
    {% assign mt =  section.settings.margin_top | prepend: 'mt-' %}
    {% assign mb =  section.settings.margin_bottom | prepend: 'mb-' %}

    <section
        id="recently-viewed-products"
        class="recently-viewed-products d-none {% if section.settings.bg_light %}bg-light{% endif %} {{ pt }} {{ pb }} {{ mt }} {{ mb }}"
        data-limit="{{ section.settings.limit }}"
        data-animate="{{ section.settings.animate_class }}"
        data-img-width="{{ section.settings.img_width }}"
        data-img-height="{{ section.settings.img_height }}"
        data-img-thumbnail="{{ section.settings.img_thumbnail }}"
        data-product-title-heading-size="{{ section.settings.product_title_heading_size }}">
        <div class="{% if section.settings.container %}container{% else %}container-fluid{% endif %}">

            <!-- Title -->
            <h2 class="title mb-1 {{ section.settings.title_alignment }} {{ section.settings.title_size }}">
                {{ section.settings.title }}
            </h2>

            <!-- Description -->
            {% if section.settings.description != blank %}
                <div class="description rte  text-muted mb-6 {{ section.settings.title_alignment }}">
                    {{ section.settings.description }}
                </div>
            {% endif %}

            <div
                id="splide-{{ section.id }}"
                class="not-splide"
                data-splide='{
                    "type": "slide",
                    "rewind": {{ section.settings.carousel_rewind }},
                    "perPage": {{ section.settings.breakpoint_xxl }},
                    "easing": "{{ section.settings.carousel_easing }}",
                    "speed": {{ section.settings.carousel_speed }},
                    "arrows": {{ section.settings.carousel_arrows }},
                    "pagination": {{ section.settings.carousel_pagination }},
                    "autoplay": {{ section.settings.carousel_autoplay }},
                    "interval": {{ section.settings.carousel_interval | times: 1000 }},
                    "keyboar": "focused",
                    "breakpoints": {
                        "576": {
                            "perPage": {{ section.settings.breakpoint_xm }}
                        },
                        "768": {
                            "perPage": {{ section.settings.breakpoint_sm }}
                        },
                        "992": {
                            "perPage": {{ section.settings.breakpoint_md }}
                        },
                        "1200": {
                            "perPage": {{ section.settings.breakpoint_lg }}
                        },
                        "1400": {
                            "perPage": {{ section.settings.breakpoint_xl }}
                        }
                    },
                    "i18n": {
                        "prev":	"{{ 'general.splide.prev' | t }}",
                        "next":	"{{ 'general.splide.next' | t }}",
                        "first": "{{ 'general.splide.first' | t }}",
                        "last":	"{{ 'general.splide.last' | t }}",
                        "slideX": "{{ 'general.splide.slideX' | t }} %s",
                        "pageX": "{{ 'general.splide.pageX' | t }} %s",
                        "play":	"{{ 'general.splide.play' | t }}",
                        "pause": "{{ 'general.splide.pause' | t }}"
                    }
                }'>

                <script>
                    {% assign taxa_decima_segunda_parcela = settings.taxa_decima_segunda_parcela | divided_by: 100 | plus: 1 %}
                    let taxa_decima_segunda_parcela = Number('{{ taxa_decima_segunda_parcela }}')
                    let parcelamento_enable = Boolean({{ settings.parcelamento_enable}})
                </script>
                <div class="splide__track mb-2">
                    <ul class="product-list animated-list splide__list list-unstyled my-n4 mx-n2">
                        <!-- Auto injected via JS -->
                    </ul>
                </div>

            </div>

        </div>
    </section>
{% endif %}
{% schema %}
{
    "name": {
     "en": "Recently viewed",
     "pt-BR": "Vistos recentemente"
    },
    "settings": [
        {
            "type": "paragraph",
            "content": {
             "en": "Show up to 20 products based on the products recently viewed by the user. Will not be displayed if the user has only viewed one product. Data is stored in the user's localStorage browser and loaded via JavaScript",
             "pt-BR": "Mostrar até 20 produtos com base nos produtos visualizados recentemente pelo usuário. Não será exibido se o usuário tiver visualizado apenas um produto. Os dados são armazenados no navegador localStorage do usuário e carregados via JavaScript"
            }
        },
        {
            "type": "header",
            "content": {
             "en": "General settings",
             "pt-BR": "Configurações gerais"
            }
        },
        {
            "type": "checkbox",
            "id": "enable_section",
            "label": {
             "en": "Activate section",
             "pt-BR": "Ativar seção"
            },
            "default": false
        },
        {
            "type": "text",
            "id": "title",
            "label": "Título",
            "default": {
             "en": "Recently viewed products",
             "pt-BR": "Produtos vistos recentemente"
            }
        },
        {
            "type": "richtext",
            "id": "description",
            "label": {
             "en": "Description",
             "pt-BR": "Descrição"
            },
            "default": {
             "en": "<p>Write something attractive for this section.</p>",
             "pt-BR": "<p>Escreva algo atraente para esta seção.</p>"
            }
        },
        {
            "type": "checkbox",
            "id": "container",
            "label": {
             "en": "Wrap container",
             "pt-BR": "Wrap container"
            },
            "default": true
        },
        {
            "type": "checkbox",
            "id": "bg_light",
            "label": {
             "en": "Light color background",
             "pt-BR": "Fundo claro"
            },
            "default": false
        },
        {
            "type": "select",
            "id": "title_alignment",
            "label": {
             "en": "Title alignment",
             "pt-BR": "Alinhamento do título"
            },
            "options": [
                { "value": "text-left", "label": {"en": "Left","pt-BR": "Esquerda"} },
                { "value": "text-center", "label": {"en": "Center","pt-BR": "Centro"} },
                { "value": "text-right", "label": {"en": "Right","pt-BR": "Direita"} }
            ],
            "default": "text-center"
        },
        {
            "type": "select",
            "id": "title_size",
            "label": {
             "en": "Title size",
             "pt-BR": "Tamanho do título"
            },
            "default": "h2",
            "options": [
                {  "value": "h1", "label": "H1" },
                {  "value": "h2", "label": "H2" },
                {  "value": "h3", "label": "H3" },
                {  "value": "h4", "label": "H4" },
                {  "value": "h5", "label": "H5" },
                {  "value": "h6", "label": "H6" }
            ]
        },
        {
            "type": "range",
            "id": "limit",
            "label": {
             "en": "Product count",
             "pt-BR": "Contagem de produtos"
            },
            "min": 1,
            "max": 20,
            "step": 1,
            "default": 15
        },
        {
            "type": "header",
            "content": {
             "en": "Carousel settings",
             "pt-BR": "Configurações de carrossel"
            }
        },
        {
            "type": "checkbox",
            "id": "carousel_arrows",
            "label": {
             "en": "Show controls",
             "pt-BR": "Mostrar controles"
            },
            "info": {
             "en": "Previous / Next Icons",
             "pt-BR": "Ícones anterior / seguinte"
            },
            "default": false
        },
        {
            "type": "checkbox",
            "id": "carousel_pagination",
            "label": {
             "en": "Show pagination",
             "pt-BR": "Mostrar paginação"
            },
            "info": {
             "en": "Small dots at the bottom",
             "pt-BR": "Pequenos pontos na parte inferior"
            },
            "default": true
        },
        {
            "type": "checkbox",
            "id": "carousel_rewind",
            "label": {
             "en": "Carousel rewind",
             "pt-BR": "Retroceder"
            },
            "info": {
             "en": "Move to first slide when done",
             "pt-BR": "Mova para o primeiro slide quando terminar"
            },
            "default": true
        },
        {
            "type": "header",
            "content": {
             "en": "Autoplay Carousel",
             "pt-BR": "Carrossel Autoplay"
            }
        },
        {
            "type": "checkbox",
            "id": "carousel_autoplay",
            "label": {
             "en": "Autoplay",
             "pt-BR": "Autoplay"
            },
            "default": false
        },
        {
            "type": "range",
            "id": "carousel_interval",
            "label": {
             "en": "Carousel interval",
             "pt-BR": "Tempo do Autoplay"
            },
            "default": 6,
            "min": 0,
            "max": 20,
            "step": 1,
            "unit": "sec"
        },
        {
            "type": "header",
            "content":  {
             "en": "Carousel transition",
             "pt-BR": "Transição Carrossel"
            }
        },
        {
            "type": "text",
            "id": "carousel_easing",
            "label": {
             "en": "Transition effect",
             "pt-BR": "Efeito de transição"
            },
            "info": {
             "en": "[Learn more](https://cubic-bezier.com/#.42,.65,.27,.99)",
             "pt-BR": "[Saber mais](https://cubic-bezier.com/#.42,.65,.27,.99)"
            },
            "default": "cubic-bezier(.42,.65,.27,.99)"
        },
        {
            "type": "text",
            "id": "carousel_speed",
            "label": {
             "en": "Transition speed",
             "pt-BR": "Velocidade de transição"
            },
            "default": "400"
        },
        {
            "type": "header",
            "content": {
             "en": "Product settings",
             "pt-BR": "Configurações do produto"
            }
        },
        {
            "type": "text",
            "id": "img_width",
            "label": {
               "en": "Image width (px)",
               "pt-BR": "Largura da imagem (px)"
             },
            "default": "480"
        },
        {
            "type": "text",
            "id": "img_height",
            "label": {
               "en": "Image height (px)",
               "pt-BR": "Altura da imagem (px)"
             },
            "default": "480"
        },
        {
            "type": "checkbox",
            "id": "img_thumbnail",
            "label": {
               "en": "Image border",
               "pt-BR": "Borda da imagem"
             },
            "default": true
        },
        {
            "type": "select",
            "id": "product_title_heading_size",
            "label": {
             "en": "Title size",
             "pt-BR": "Tamanho do título"
            },
            "default": "h6",
            "options": [
                { "value": "h1", "label": "H1" },
                { "value": "h2", "label": "H2" },
                { "value": "h3", "label": "H3" },
                { "value": "h4", "label": "H4" },
                { "value": "h5", "label": "H5" },
                { "value": "h6", "label": "H6" }
            ]
        },
        {
            "type": "checkbox",
            "id": "show_price",
            "label": {
             "en": "Show price",
             "pt-BR": "Mostrar preço"
            },
            "default": true
        },
{
