             "pt-BR": "Produtos por slide /xm"
            },
            "info": {
             "en": "Screen width: <=576px",
             "pt-BR": "Largura da tela: <=576px"
            },
            "min": 1,
            "max": 3,
            "step": 1,
            "default": 2
        },
        {
            "type": "range",
            "id": "breakpoint_sm",
            "label": {
             "en": "Products per slide /sm",
             "pt-BR": "Produtos por slide /sm"
            },
            "info": {
             "en": "Screen width: <=768px",
             "pt-BR": "Largura da tela: <=768px"
            },
            "min": 1,
            "max": 3,
            "step": 1,
            "default": 2
        },
        {
            "type": "range",
            "id": "breakpoint_md",
            "label": {
             "en": "Products per slide /md",
             "pt-BR": "Produtos por slide /md"
            },
            "info": {
             "en": "Screen width: <=992px",
             "pt-BR": "Largura da tela: <=992px"
            },
            "min": 1,
