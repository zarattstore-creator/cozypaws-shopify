            "min": 0,
            "max": 15,
            "step": 1,
            "default": 0
        },
        {
            "type": "range",
            "id": "margin_bottom",
            "label": {
             "en": "Margin bottom",
             "pt-BR": "Margem inferior"
            },
            "min": 0,
            "max": 15,
            "step": 1,
            "default": 9
        }
    ]
}
{% endschema %}
