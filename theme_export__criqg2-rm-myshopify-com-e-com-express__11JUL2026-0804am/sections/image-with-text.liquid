{% assign pt =  section.settings.padding_top | prepend: 'pt-' %}
{% assign pb =  section.settings.padding_bottom | prepend: 'pb-' %}
{% assign mt =  section.settings.margin_top | prepend: 'mt-' %}
{% assign mb =  section.settings.margin_bottom | prepend: 'mb-' %}

<div
    id="image-with-text-{{ section.id }}"
    class="image-with-text {{ pt }} {{ pb }} {{ mt }} {{ mb }} {{ section.settings.bg_color }} {% unless section.settings.animate_class == blank %}animate__animated{% endunless %}"
    data-animate="{{ section.settings.animate_class }}">
    <div class="{% if section.settings.container %} container{% else %}container-fluid{% endif %}">

        <div class="row align-items-center {{ section.settings.img_alignment }}">

            <div class="col-md">
                {% if section.settings.img != blank %}
                    {% assign img_size = section.settings.img_width | append: 'x' | append: section.settings.img_height %}
                    <img
                        class="img-fluid mb-4 mb-md-0 {% if section.settings.img_thumbnail %}img-thumbnail{% else %}rounded{% endif %}"
                        data-src="{{ section.settings.img.src | img_url: img_size, crop: 'center' }}"
                        alt="{{ section.settings.image.alt | escape }}"
                        width="{{ section.settings.img_width }}"
                        height="{{ section.settings.img_height }}"
                        loading="lazy">
                {% else %}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg bg-light mb-4 mb-md-0 rounded' }}
                {% endif %}
            </div>

            <div class="col-md">

                {% if section.settings.title != blank %}
                    <h2 class="title {{ section.settings.title_size }}">
                        {{ section.settings.title }}
                    </h2>
                {% endif %}

                {% if section.settings.description != blank %}
                    <div class="description rte {% if section.settings.description_lead %}lead{% endif %}">
                        {{ section.settings.description }}
                    </div>
                {% endif %}

                {% if section.settings.btn_url != blank %}
                    <a href="{{ section.settings.btn_url }}" class="btn mt-5 mb-1 {{ section.settings.btn_color }} {{ section.settings.btn_size }}">
                        {{ section.settings.btn_text }}
                    </a>
                {% endif %}

            </div>

        </div>

    </div>
</div>

{% schema %}
{
    "name": {
     "en": "Image with text",
     "pt-BR": "Imagem com texto"
    },
    "settings": [
        {
            "type": "header",
            "content": {
             "en": "Configurações gerais",
             "pt-BR": "Configurações Gerais"
            }
        },
        {
            "type": "select",
            "id": "bg_color",
            "label": {
             "en": "Background color",
             "pt-BR": "Cor do fundo"
            },
            "default": "bg-white text-body",
            "options": [
                { "group": "Light", "value": "bg-white text-body", "label": "White" },
                { "group": "Light", "value": "bg-light text-body", "label": "Light" },
                { "group": "Dark", "value": "bg-dark text-white", "label": "Dark" },
                { "group": "Dark", "value": "bg-primary text-white", "label": "Primary" },
                { "group": "Dark", "value": "bg-secondary text-white", "label": "Secondary" },
                { "group": "Gradient", "value": "bg-dark-gradient text-white", "label": "Dark" },
                { "group": "Gradient", "value": "bg-primary-gradient text-white", "label": "Primary" },
                { "group": "Gradient", "value": "bg-secondary-gradient text-white", "label": "Secondary" },
                { "group": "Gradient", "value": "bg-custom-gradient text-white", "label": "Custom" }
            ]
        },
        {
            "type": "checkbox",
            "id": "container",
            "label": {
             "en": "Wrap Container",
             "pt-BR": "Enrolar Container"
            },
            "default": true
        },
        {
            "type": "header",
            "content": {
             "en": "Image settings",
             "pt-BR": "Configurações de imagem"
            }
        },
        {
            "type": "image_picker",
            "id": "img",
            "label": {
             "en": "Image",
             "pt-BR": "Imagem"
            }
        },
        {
            "type": "text",
            "id": "img_width",
            "label": {
               "en": "Image width (px)",
               "pt-BR": "Largura da imagem (px)"
             },
            "default": "720"
        },
        {
            "type": "text",
            "id": "img_height",
            "label": {
               "en": "Image height (px)",
               "pt-BR": "Altura da imagem (px)"
            },
            "default": "405"
        },
        {
            "type": "checkbox",
            "id": "img_thumbnail",
            "label": {
               "en": "Image border",
               "pt-BR": "Borda da imagem"
             },
            "default": false
        },
        {
            "type": "select",
            "id": "img_alignment",
            "label": {
             "en": "Image alignment",
             "pt-BR": "Alinhamento da imagem"
            },
            "info": {
             "en": "Note: On mobile, the image will always be at the top and the text at the bottom",
             "pt-BR": "Nota: No celular, a imagem estará sempre na parte superior e o texto na parte inferior"
            },
            "default": "flex-row",
            "options": [
                { "value": "flex-row", "label": {"en": "Left" ,"pt-BR": "Esquerda"} },
                { "value": "flex-row-reverse", "label": {"en": "Right" ,"pt-BR": "Direita"} }
            ]
        },
        {
            "type": "header",
            "content": {
             "en": "Text Settings",
             "pt-BR": "Configurações de texto"
            }
        },
        {
            "type": "text",
            "id": "title",
            "label": {
             "en": "Title",
             "pt-BR": "Título"
            },
            "default": {
             "en": "Image with text",
             "pt-BR": "Imagem com texto"
            }
        },
        {
            "type": "select",
            "id": "title_size",
            "label": {
             "en": "Title Size",
             "pt-BR": "Tamanho do Título"
            },
            "default": "h2",
            "options": [
                {  "value": "h1", "label": "H1" },
                {  "value": "h2", "label": "H2" },
                {  "value": "h3", "label": "H3" },
                {  "value": "h4", "label": "H4" },
                {  "value": "h5", "label": "H5" },
                {  "value": "h6", "label": "H6" }
            ]
        },
        {
            "type": "richtext",
            "id": "description",
            "label": {
             "en": "Description",
             "pt-BR": "Descrição"
            },
            "default": {
             "en": "<p>Combine large text with an image to focus on the product, collection, or blog post you've chosen. Add details about availability, style, or even provide a comment.</p>",
             "pt-BR": "<p>Combine um texto grande com uma imagem para dar foco ao produto, coleção ou postagem do blog que você escolheu. Adicione detalhes sobre disponibilidade, estilo ou até mesmo forneça um comentário.</p>"
            }
        },
        {
            "type": "checkbox",
            "id": "description_lead",
            "label": {
             "en": "Description lead",
             "pt-BR": "Descrição principal"
            },
            "default": false
        },
        {
            "type": "header",
            "content": {
             "en": "Button settings",
             "pt-BR": "Configurações de botão"
            }
        },
        {
            "type": "url",
            "id": "btn_url",
            "label": {
             "en": "Button URL",
             "pt-BR": "URL do botão"
            },
            "info": {
             "en": "Leave blank to disable the button",
             "pt-BR": "Deixe em branco para desativar o botão"
            }
        },
        {
            "type": "text",
            "id": "btn_text",
            "label": {
             "en": "Text Button",
             "pt-BR": "Botão de texto"
            },
            "default": {
             "en": "Learn More",
             "pt-BR": "Saber mais"
            }
        },
        {
            "type": "select",
            "id": "btn_color",
            "label": "Cor do botão",
            "default": "btn-outline-primary",
            "options": [
                { "group": "Normal", "value": "btn-light", "label": {"en": "Light","pt-BR": "Claro"} },
                { "group": "Normal", "value": "btn-dark", "label": {"en": "Dark","pt-BR": "Escuro"} },
                { "group": "Normal", "value": "btn-primary", "label": {"en": "Primary from theme","pt-BR": "Primária do tema"} },
                { "group": "Normal", "value": "btn-secondary", "label": {"en": "Secondary from theme","pt-BR": "Secundária do tema"} },
                { "group": "Normal", "value": "btn-success", "label": {"en": "Success","pt-BR": "Sucesso"} },
                { "group": "Normal", "value": "btn-danger", "label": {"en": "Danger","pt-BR": "Perigo"} },
                { "group": "Normal", "value": "btn-warning", "label": {"en": "Warning","pt-BR": "Cuidado"} },
                { "group": "Normal", "value": "btn-info", "label": {"en": "Info","pt-BR": "Informações"} },
                { "group": "Outline", "value": "btn-outline-dark", "label": {"en": "Dark outline","pt-BR": "Contorno escuro"}},
                { "group": "Outline", "value": "btn-outline-primary", "label": {"en": "Primary from theme outline","pt-BR": "Contorno primaria do tema"} },
                { "group": "Outline", "value": "btn-outline-secondary", "label": {"en": "Secondary from theme outline","pt-BR": "Contorno secundária do tema"} },
                { "group": "Outline", "value": "btn-outline-success", "label": {"en": "Success outline","pt-BR": "Contorno Sucesso"} },
                { "group": "Outline", "value": "btn-outline-danger", "label": {"en": "Danger outline","pt-BR": "Contorno Perigo"} },
                { "group": "Outline", "value": "btn-outline-warning", "label": {"en": "Warning outline","pt-BR": "Contorno Cuidado"} },
                { "group": "Outline", "value": "btn-outline-info", "label": {"en": "Info outline","pt-BR": "Contorno Informações"}}
            ]
        },
        {
            "type": "select",
            "id": "btn_size",
            "label": {
               "en": "Button size",
               "pt-BR": "Tamanho do botão"
             },
             "options":[
                {
                   "value":"btn-sm",
                   "label":{
                     "en": "Small",
                     "pt-BR": "Pequeno"
                   }
                },
                {
                   "value":"",
                   "label":{
                     "en": "Normal",
                     "pt-BR": "Normal"
                   }
                },
                {
                   "value":"btn-lg",
                   "label":{
                     "en": "Large",
                     "pt-BR": "Grande"
                   }
                }
             ]
        },
        {
            "type": "header",
            "content": {
             "en": "Spacing",
             "pt-BR": "Espaçamento"
            },
            "info": {
             "en": "Based on Bootstrap Spacing Utility Classes [Learn More](https://getbootstrap.com/docs/4.5/utilities/spacing/)",
             "pt-BR": "Com base nas classes do utilitário de espaçamento Bootstrap [Saiba mais](https://getbootstrap.com/docs/4.5/utilities/spacing/)"
            }
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": {
             "en": "Padding Top",
             "pt-BR": "Espaçamento superior"
            },
            "min": 0,
            "max": 15,
            "step": 1,
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": {
             "en": "Padding bottom",
             "pt-BR": "Espaçamento inferior"
            },
            "min": 0,
            "max": 15,
            "step": 1,
            "default": 0
        },
        {
            "type": "range",
            "id": "margin_top",
            "label": {
             "en": "Margin top",
             "pt-BR": "Margem superior"
            },
            "min": 0,
            "max": 15,
            "step": 1,
            "default": 0
        },
        {
            "type": "range",
            "id": "margin_bottom",
            "label": {
             "en": "Margin bottom",
             "pt-BR": "Margem inferior"
            },
            "min": 0,
            "max": 15,
            "step": 1,
            "default": 9
        }

    ],
    "presets": [
        {
            "name": {
             "en": "Image with text",
             "pt-BR": "Imagem com texto"
            },
            "category": {
             "en": "image",
             "pt-BR": "imagem"
            }
        }
    ]
}
{% endschema %}
