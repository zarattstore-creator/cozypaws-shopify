                     "pt-BR": "Data"
                    }
                },
                {
                    "type": "text",
                    "id": "customer_name",
                    "label": {
                     "en": "Customer name",
                     "pt-BR": "Nome do cliente"
                    }
                },
                {
                    "type": "text",
                    "id": "customer_description",
                    "label": {
