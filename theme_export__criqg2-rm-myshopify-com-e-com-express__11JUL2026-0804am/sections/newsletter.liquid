{% assign pt =  section.settings.padding_top | prepend: 'pt-' %}
{% assign pb =  section.settings.padding_bottom | prepend: 'pb-' %}
{% assign mt =  section.settings.margin_top | prepend: 'mt-' %}
{% assign mb =  section.settings.margin_bottom | prepend: 'mb-' %}

<section
    class="newsletter {{ pt }} {{ pb }} {{ mt }} {{ mb }}">
    <div
        class="container text-center {% unless section.settings.animate_class == blank %}animate__animated{% endunless %}"
        data-animate="{{ section.settings.animate_class }}">

        <h2 class="title mb-1">
            {{ section.settings.title }}
        </h2>

        {% if section.settings.description != blank %}
            <div class="description rte  text-muted mb-6">
                {{ section.settings.description }}
            </div>
        {% endif %}

        <!-- Newsletter form -->
        {% form 'customer', id: 'newsletter_form', class: '' %}
            <input type="hidden" name="contact[tags]" value="newsletter">

            {{ form.errors | default_errors }}

            {% if form.posted_successfully? %}
                <p class="alert alert-success">
                    {{ 'general.newsletter.confirmation' | t }}
                </p>
            {% endif %}

            <div class="form-inline flex-nowrap justify-content-center">

                <!-- Newsletter input field -->
                <input
                    type="email"
                    name="contact[email]"
                    size="30"
                    class="form-control mr-2"
                    value="{% if customer.email != blank %}{{ customer.email }}{% endif %}"
                    placeholder="{{ 'general.newsletter.label' | t }}"
                    aria-label="{{ 'general.newsletter.label' | t }}"
                    autocorrect="off"
                    autocapitalize="off">

                    <button
                        type="submit"
                        name="commit"
                        class="btn flex-shrink-0 {{ section.settings.btn_color }} {{ section.settings.btn_size }}">
                    {{ 'general.newsletter.submit' | t }}
                </button>
            </div>
        {% endform %}

        <!-- Note -->
        {% if section.settings.note != blank %}
            <div class="rte small text-muted font-italic mt-4 mb-n3">
                {{ section.settings.note }}
            </div>
        {% endif %}

    </div>
</section>


{% schema %}
{
    "name": {
             "en": "Newsletter",
             "pt-BR": "Newsletter"
            },
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": {
             "en": "Title",
             "pt-BR": "Título"
            },
            "default": {
             "en": "Subscribe to the Newsletter",
             "pt-BR": "Inscreva-se na Newsletter"
            }
        },
        {
            "type": "richtext",
            "id": "description",
            "label": {
             "en": "Description",
             "pt-BR": "Descrição"
            },
            "default": {
             "en": "<p>Be the first to be notified of our latest offers.</p>",
             "pt-BR": "<p>Seja o primeiro a ser notificado sobre nossas últimas ofertas.</p>"
            }
        },
        {
            "type": "richtext",
            "id": "note",
            "label": "Note",
            "info": {
             "en": "It will be displayed below the newsletter form",
             "pt-BR": "Será exibido abaixo do formulário do boletim informativo"
            },
            "default": {
             "en": "<p>Note: We usually ship once a week</p>",
             "pt-BR": "<p>Observação: geralmente enviamos uma vez por semana</p>"
            }
        },
        {
            "type": "select",
            "id": "bg_color",
            "label": {
             "en": "Background color",
             "pt-BR": "Cor do background"
            },
            "default": "bg-primary-gradient text-white",
            "options": [
                { "group": "Light", "value": "bg-white text-body", "label": "White" },
                { "group": "Light", "value": "bg-light text-body", "label": "Light" },
                { "group": "Dark", "value": "bg-dark text-white", "label": "Dark" },
                { "group": "Dark", "value": "bg-primary text-white", "label": "Primary" },
                { "group": "Dark", "value": "bg-secondary text-white", "label": "Secondary" },
                { "group": "Gradient", "value": "bg-dark-gradient text-white", "label": "Dark" },
                { "group": "Gradient", "value": "bg-primary-gradient text-white", "label": "Primary" },
                { "group": "Gradient", "value": "bg-secondary-gradient text-white", "label": "Secondary" }
            ]
        },
        {
            "type": "select",
            "id": "btn_color",
            "label": {
             "en": "Button color",
             "pt-BR": "Cor do botão"
            },
            "default": "btn-primary",
            "options": [
                { "group": "Normal", "value": "btn-link", "label": {"en": "Link","pt-BR": "Link"} },
                { "group": "Normal", "value": "btn-light", "label": {"en": "Light","pt-BR": "Claro"} },
                { "group": "Normal", "value": "btn-dark", "label": {"en": "Dark","pt-BR": "Escuro"} },
                { "group": "Normal", "value": "btn-primary", "label": {"en": "Primary from theme","pt-BR": "Primária do tema"} },
                { "group": "Normal", "value": "btn-secondary", "label": {"en": "Secondary from theme","pt-BR": "Secundária do tema"} },
                { "group": "Normal", "value": "btn-success", "label": {"en": "Success","pt-BR": "Sucesso"} },
                { "group": "Normal", "value": "btn-danger", "label": {"en": "Danger","pt-BR": "Perigo"} },
                { "group": "Normal", "value": "btn-warning", "label": {"en": "Warning","pt-BR": "Cuidado"} },
                { "group": "Normal", "value": "btn-info", "label": {"en": "Info","pt-BR": "Informações"} },
                { "group": "Outline", "value": "btn-outline-dark", "label": {"en": "Dark outline","pt-BR": "Contorno escuro"}},
                { "group": "Outline", "value": "btn-outline-primary", "label": {"en": "Primary from theme outline","pt-BR": "Contorno primaria do tema"} },
                { "group": "Outline", "value": "btn-outline-secondary", "label": {"en": "Secondary from theme outline","pt-BR": "Contorno secundária do tema"} },
                { "group": "Outline", "value": "btn-outline-success", "label": {"en": "Success outline","pt-BR": "Contorno Sucesso"} },
                { "group": "Outline", "value": "btn-outline-danger", "label": {"en": "Danger outline","pt-BR": "Contorno Perigo"} },
                { "group": "Outline", "value": "btn-outline-warning", "label": {"en": "Warning outline","pt-BR": "Contorno Cuidado"} },
                { "group": "Outline", "value": "btn-outline-info", "label": {"en": "Info outline","pt-BR": "Contorno Informações"}}
            ]
        },
        {
            "type": "select",
            "id": "btn_size",
            "label": {
             "en": "Button size",
             "pt-BR": "Tamanho do botão"
            },
            "default": "btn-lg",
            "options": [
                { "value": "btn-sm", "label": {"en": "Small","pt-BR": "Pequeno"} },
                { "value": "", "label": {"en": "Normal","pt-BR": "Normal"} },
                { "value": "btn-lg", "label": {"en": "Large","pt-BR": "Grande"} }
            ]
        },
        {
            "type": "header",
            "content": {
             "en": "Spacing",
             "pt-BR": "Espaçamento"
            },
            "info": {
             "en": "Based on Bootstrap Spacing Utility Classes [Learn More](https://getbootstrap.com/docs/4.5/utilities/spacing/)",
             "pt-BR": "Com base nas classes do utilitário de espaçamento Bootstrap [Saiba mais](https://getbootstrap.com/docs/4.5/utilities/spacing/)"
            }
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": {
             "en": "Padding top",
             "pt-BR": "Espaçamento superior"
            },
            "min": 0,
            "max": 12,
            "step": 1,
            "default": 8
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": {
             "en": "Padding bottom",
             "pt-BR": "Espaçamento inferior"
            },
            "min": 0,
            "max": 12,
            "step": 1,
            "default": 8
        },
        {
            "type": "range",
            "id": "margin_top",
            "label": {
             "en": "Margin top",
             "pt-BR": "Margem superior"
            },
            "min": 0,
            "max": 12,
            "step": 1,
            "default": 0
        },
        {
            "type": "range",
            "id": "margin_bottom",
            "label": {
             "en": "Show orbe logo",
             "pt-BR": "Mostrar logotipo orbe"
            },
            "min": 0,
            "max": 12,
            "step": 1,
            "default": 9
        }
    ],
    "presets": [
        {
            "name": {
             "en": "Newsletter",
             "pt-BR": "Newsletter"
            },
            "category": "home"
        }
    ]
}
{% endschema %}
